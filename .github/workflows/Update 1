
name: Kato Tu Tien - ZIP Update

on:
  workflow_dispatch:
    inputs:
      zip_name:
        description: "Ten file ZIP trong itsk4to/File-Update"
        required: true
        default: "KatoTT-v3.8.0-manual-moderation-update.zip"
        type: string

permissions:
  contents: write
  pull-requests: write

concurrency:
  group: ktt-zip-update
  cancel-in-progress: false

jobs:
  update-and-test:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout main
        uses: actions/checkout@v4
        with:
          ref: main
          fetch-depth: 0

      - name: Validate ZIP filename
        shell: bash
        env:
          ZIP_NAME: ${{ inputs.zip_name }}
        run: |
          if [[ ! "$ZIP_NAME" =~ ^KatoTT-v[0-9]+\.[0-9]+\.[0-9]+[-A-Za-z0-9_.]*\.zip$ ]]; then
            echo "Ten ZIP khong hop le: $ZIP_NAME"
            exit 1
          fi

      - name: Download update ZIP
        shell: bash
        env:
          ZIP_NAME: ${{ inputs.zip_name }}
        run: |
          curl --fail --location --retry 3 \
            "https://raw.githubusercontent.com/itsk4to/File-Update/main/$ZIP_NAME" \
            --output /tmp/ktt-update.zip
          unzip -t /tmp/ktt-update.zip

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Apply ZIP safely
        run: |
          python - <<'PY'
          from pathlib import Path, PurePosixPath
          from zipfile import ZipFile
          import stat

          archive = Path("/tmp/ktt-update.zip")
          project = Path("kato-tutien").resolve()
          protected = {".env", ".git", ".github", "__pycache__", ".venv"}
          protected_suffixes = {".db", ".sqlite", ".sqlite3"}
          max_total = 100 * 1024 * 1024
          written = 0

          with ZipFile(archive) as zf:
              entries = [i for i in zf.infolist() if not i.is_dir()]

              if not entries:
                  raise SystemExit("ZIP khong co file.")

              if sum(i.file_size for i in entries) > max_total:
                  raise SystemExit("ZIP vuot qua 100 MB.")

              for info in entries:
                  raw = info.filename.replace("\\", "/")
                  parts = list(PurePosixPath(raw).parts)

                  if not parts or raw.startswith("/") or ".." in parts:
                      raise SystemExit(f"Duong dan khong an toan: {raw}")

                  if stat.S_ISLNK(info.external_attr >> 16):
                      raise SystemExit(f"Khong chap nhan symlink: {raw}")

                  if "kato-tutien" in parts:
                      parts = parts[parts.index("kato-tutien") + 1:]
                  elif len(parts) > 1 and parts[0].lower().startswith(
                      ("katott", "katotutien")
                  ):
                      parts = parts[1:]

                  if not parts:
                      continue

                  if any(p in protected for p in parts):
                      print(f"Bo qua tep bao ve: {raw}")
                      continue

                  name = parts[-1]

                  if name.lower() == ".env" or name.lower().endswith(
                      tuple(protected_suffixes)
                  ):
                      print(f"Bo qua du lieu nhay cam: {raw}")
                      continue

                  target = project.joinpath(*parts).resolve()

                  if target != project and project not in target.parents:
                      raise SystemExit(f"Duong dan vuot project: {raw}")

                  target.parent.mkdir(parents=True, exist_ok=True)
                  target.write_bytes(zf.read(info))
                  written += 1
                  print(f"Updated: {target.relative_to(project)}")

          if written == 0:
              raise SystemExit("Khong co file nao duoc cap nhat.")

          print(f"Da cap nhat {written} file.")

          PY

      - name: Install and test
        working-directory: kato-tutien
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt -r requirements-dev.txt
          python -m compileall -q .
          python -m pytest -q

      - name: Create update Pull Request
        env:
          GH_TOKEN: ${{ github.token }}
          ZIP_NAME: ${{ inputs.zip_name }}
          RUN_ID: ${{ github.run_id }}
        run: |
          if git diff --quiet -- kato-tutien; then
            echo "Khong co thay doi."
            exit 1
          fi

          SAFE_NAME="${ZIP_NAME%.zip}"
          BRANCH="automation/${SAFE_NAME}-${RUN_ID}"

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git switch -c "$BRANCH"
          git add kato-tutien
          git commit -m "Apply ${SAFE_NAME}"
          git push --set-upstream origin "$BRANCH"

          gh pr create \
            --base main \
            --head "$BRANCH" \
            --title "Kato Tu Tien update: ${SAFE_NAME}" \
            --body "ZIP: ${ZIP_NAME}

          Compileall va pytest da chay thanh cong.
          Hay kiem tra thay doi truoc khi Merge.
          Database, .env va tep SQLite duoc bo qua."
