DISCORD_TOKEN=
KATO_OWNER_IDS=
# Set the new admin/Thiên Đạo password in your host secret settings; do not commit it.
KATO_ADMIN_PASSWORD=
KATO_DB_PATH=kato_tutien.db
KATO_CUSTOM_EMOJI=1

# Discord server moderation: comma-separated role IDs.
KATO_MOD_ADMIN_ROLE_IDS=
KATO_MODERATOR_ROLE_IDS=
# Optional private text-channel ID for moderation case logs.
KATO_MOD_LOG_CHANNEL_ID=

# Heavenly Dao prison setup (Discord IDs, not names). Configure role + text channels before /phattu.
KATO_PRISON_ROLE_ID=
KATO_PRISON_CHANNEL_ID=
KATO_PRISON_ANNOUNCE_CHANNEL_ID=
# One successful .kthac every N seconds; each accepted attempt always gives 10 labour stones.
KATO_PRISON_COOLDOWN_SECONDS=30
KATO_PRISON_MAX_REQUIRED_STONES=1000000
